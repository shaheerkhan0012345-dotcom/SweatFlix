# Supabase Configuration
# Replace these with your actual Supabase project URL and anon key from Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Developer & Test Flags
# Set to 'true' to show test toggles (reset onboarding, reset ads, test premium). Set to 'false' for production.
EXPO_PUBLIC_SHOW_TEST_TOOLS=true

# Cloudinary CDN Configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_CLOUD_ID=your_cloud_id
